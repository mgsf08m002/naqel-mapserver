venv/
.venv/
env/
ENV/

# Django
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
/staticfiles/
/static_root/
/media_root/
/media/*
!/media/.gitkeep
!/media/profile_images/.gitkeep

