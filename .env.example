# GeoTrak Maps. Copy to .env. Database, Martin and Nginx come from ../geo-infra.

SECRET_KEY=change-me-long-random-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,139.162.60.105
# Plain HTTP on :8000 until TLS is added in Nginx:
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# App database (shared PostGIS instance, service name `postgis` on the geo_shared network)
DB_NAME=geotrak
DB_USER=geotrak_user
DB_PASSWORD=change-me-geotrak          # = GEOTRAK_DB_PASSWORD in geo-infra/.env
DB_HOST=postgis
DB_PORT=5432

# Riyadh road network: second database, same instance, same owner role
RIYADH_ROADS_DB_NAME=riyadh_roads
RIYADH_ROADS_DB_USER=geotrak_user
RIYADH_ROADS_DB_PASSWORD=change-me-geotrak
RIYADH_ROADS_DB_HOST=postgis
RIYADH_ROADS_DB_PORT=5432

# Tiles: Nginx serves /tiles/<source>/{z}/{x}/{y} and validates each request here
TILES_PUBLIC_PATH=/tiles
TILE_AUTH_SHARED_SECRET=change-me-long-random-string   # = TILE_AUTH_SHARED_SECRET in geo-infra/.env
TILE_ACCESS_LOG_SESSION_USAGE=True

MAPTILER_API_KEY=

GUNICORN_WORKERS=3
GUNICORN_THREADS=4        # gthread: each worker answers tile-auth calls concurrently
GUNICORN_TIMEOUT=120
DB_CONN_MAX_AGE=60        # reuse Postgres connections (seconds)
